# Copy to .env and fill in values. NEVER commit .env (it is gitignored).
# In production these come from GCP Secret Manager (specs/06-deployment.md).

# Google Maps Platform key (Routes v2, Elevation, Places, Maps MCP)
MAPS_API_KEY=

# Gemini API key for the agents (and the eval judge)
GEMINI_API_KEY=

# GCP project (GCS trip-data bucket lives here)
GOOGLE_CLOUD_PROJECT=

# Optional: live NPS park alerts; absent -> clearly-disclosed mock alerts
NPS_API_KEY=

# --- Shared-deployment login (optional locally; auth gate is off when unset) ---
FAMILY1_PASSWORD=
FAMILY2_PASSWORD=
FAMILY3_PASSWORD=
COOKIE_SECRET=

# Local toggles: SERVE_DEV_UI=0 hides the ADK dev-ui (prod default);
# FLOW_LOG=0 silences the terminal flow log; COOKIE_INSECURE=1 allows the
# auth cookie over plain http://localhost.
